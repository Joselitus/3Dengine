# Desert by day.
#
# What the web viewer (tools/scene_viewer/) shows of the map "Desierto de dia" of the game. The
# game builds that map in code (TestStage, in src/test.cpp), so this file is only a description for
# the viewer: keep it in sync with the objects of TestStage (the props are the same list). The
# sun, the light and the sky follow the time of day, as in the game (VehicleStage::onTimeChanged):
# the viewer has a clock slider. Pingu and the creature are animated models and are not shown.

time_of_day   12
day_duration  360

# The sky is painted by the shader from the time of day, with dunes on the horizon
procedural_sky dunes
sky     sky/skydome_plain.obj

# Used by the viewer until the clock sets the real values
moon    -0.32 0.8 -0.5
light   0.85 0.83 0.78
fog     0.45 0.68 0.92

player  ping/PenguinoAnimado.fbx  3 ground 4
camera  0 1.6

floor   desert/dunes_loop.obj  0 -1 0
object  desert/road.obj        0 -1 0   0 1

# The RV, facing +z, and its wheels (centred on their axles: 2.4 and -2.3 in z, 1.2 to each side,
# 0.5 over the ground, which is at y = -1 in the clearing)
object  rv/rv.obj              0 ground 0   0 1
object  rv/wheel_negx.obj   -1.2 -0.5  2.4   0 1
object  rv/wheel_posx.obj    1.2 -0.5  2.4   0 1
object  rv/wheel_negx.obj   -1.2 -0.5 -2.3   0 1
object  rv/wheel_posx.obj    1.2 -0.5 -2.3   0 1

# The satellite dish (with its base), as modelled: 45 degrees from the zenith, scale 0.5
object  antenna/antenna_base.obj  4.5 ground 2 0 0.5
object  antenna/antenna_dish.obj  4.5 ground 2 0 0.5

# The sign, turned towards (3, 4)
object  sign/sign.obj   7.5 ground -1   -0.7328 1

# Cacti and rocks, scattered by a seeded script: 14 inside the road's loop, 30 outside it
object  desert/rock_a.obj         7.1 ground  -18.7    0.3   1.3
object  desert/cactus_a.obj     -13.3 ground    8.6    6.3   0.9
object  desert/cactus_b.obj       1.8 ground   18.4    5.6   1.8
object  desert/cactus_a.obj      -7.5 ground  -15.2    1.7   1.4
object  desert/rock_a.obj        19.1 ground    8.2    1.4   2.2
object  desert/cactus_a.obj      14.6 ground  -15.1    0.0   1.5
object  desert/rock_b.obj        -6.4 ground   12.5    0.9   1.4
object  desert/cactus_b.obj     -17.1 ground   -0.7    5.9   0.9
